{
  "name": "deltav-website",
  "version": "0.1.0",
  "private": false,
  "description": "Delta V public website — sovereign AI, Web3, and OpSec. Next.js static export.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/deltaVgit/website-private.git"
  },
  "homepage": "https://deltavgit.github.io/website-private/",
  "scripts": {
    "dev": "next dev",
    "annotate": "npx -y agentation-mcp server",
    "prebuild": "node scripts/run-py.mjs scripts/copy-data.py && node scripts/run-py.mjs scripts/generate-intelhub-rss.py",
    "build": "node scripts/run-py.mjs scripts/copy-data.py && node scripts/run-py.mjs scripts/generate-intelhub-rss.py && next build && node scripts/run-py.mjs scripts/patch-basepath.py",
    "export": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck"
  },
  "browserslist": [
    "chrome >= 93",
    "edge >= 93",
    "firefox >= 92",
    "safari >= 15.4",
    "not dead"
  ],
  "dependencies": {
    "mermaid": "^11.15.0",
    "next": "16.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.124.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.17": ">=1.1.17",
      "brace-expansion@>=4.0.0 <5.0.8": ">=5.0.8",
      "postcss@<=8.5.22": ">=8.5.23",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "brace-expansion@<1.1.18": ">=1.1.18",
      "mermaid@>=11.0.0-alpha.1 <11.16.1": ">=11.16.1",
      "mermaid@>=11.5.0 <11.16.1": ">=11.16.1",
      "mermaid@>=11.6.0 <11.16.1": ">=11.16.1",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": ">=2.11.0",
      "sharp@<0.35.4": ">=0.35.4",
      "undici@>=7.28.0 <7.29.1": ">=7.29.1",
      "undici@>=7.11.0 <7.29.1": ">=7.29.1",
      "undici@>=7.0.0 <7.29.1": ">=7.29.1",
      "undici@>=7.15.0 <7.29.1": ">=7.29.1",
      "undici@>=7.1.0 <7.29.1": ">=7.29.1",
      "undici@>=7.24.1 <7.29.1": ">=7.29.1",
      "brace-expansion@<1.1.21": ">=1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12",
      "brace-expansion@<1.1.20": ">=1.1.20",
      "brace-expansion@>=4.0.0 <5.0.11": ">=5.0.11",
      "brace-expansion@<1.1.19": ">=1.1.19",
      "brace-expansion@>=4.0.0 <5.0.10": ">=5.0.10",
      "katex@>=0.11.0 <0.18.2": ">=0.18.2",
      "sharp@<0.35.5": ">=0.35.5"
    }
  }
}
