{
  "name": "deltav-website",
  "version": "0.1.0",
  "private": false,
  "description": "Delta V public website — sovereign AI, Web3, and OpSec. Next.js static export.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/deltaVgit/website-private.git"
  },
  "homepage": "https://deltavgit.github.io/website-private/",
  "scripts": {
    "dev": "next dev",
    "annotate": "npx -y agentation-mcp server",
    "prebuild": "node scripts/run-py.mjs scripts/copy-data.py && node scripts/run-py.mjs scripts/generate-intelhub-rss.py",
    "build": "node scripts/run-py.mjs scripts/copy-data.py && node scripts/run-py.mjs scripts/generate-intelhub-rss.py && next build && node scripts/run-py.mjs scripts/patch-basepath.py",
    "export": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck"
  },
  "browserslist": [
    "chrome >= 93",
    "edge >= 93",
    "firefox >= 92",
    "safari >= 15.4",
    "not dead"
  ],
  "dependencies": {
    "mermaid": "^11.15.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.124.0"
  }
}
